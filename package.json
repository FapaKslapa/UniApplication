{
  "name": "uniapplication",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:scrape-courses": "tsx scripts/scrape-courses.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:cron": "wrangler deploy -c cron-worker/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply uni-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply uni-app-db --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/luxon": "^3.7.6",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "luxon": "^3.7.2",
    "next": "^16.3.8",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "ua-parser-js": "^2.0.10",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
